# =======================================================
# .env.example — COMMIT THIS TO GITHUB
# =======================================================
# This is a TEMPLATE showing what variables are needed
# Never put real values here — just placeholders
#
# To use:
#   cp .env.example .env
#   then fill in real values in .env
#   .env is in .gitignore so it never goes to GitHub
# =======================================================

# ---- Postgres ----
DB_NAME=myapp
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---- Backend ----
PORT=3001
NODE_ENV=production

# Full connection string — built automatically in docker-compose.yml
# from the DB_ vars above. You don't set this manually.
# But if your backend reads DATABASE_URL directly from .env for local dev:
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/myapp

# ---- Auth ----
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random

# ---- MQTT (external broker) ----
MQTT_BROKER_URL=mqtt://your-hivemq-or-broker-url:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
# Topic the backend subscribes to for mat status updates. Optional — defaults to "mats/status".
MQTT_TOPIC=safebed/mayanksharma2003/mats/status
